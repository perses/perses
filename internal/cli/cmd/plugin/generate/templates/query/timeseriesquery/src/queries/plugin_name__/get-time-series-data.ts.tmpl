import type { TimeSeriesQueryPlugin } from '@perses-dev/plugin-system';
import { datasourceSelectValueToSelector, replaceVariables } from '@perses-dev/plugin-system';
import type { TimeSeriesData, TimeSeries } from '@perses-dev/spec';

import { DATASOURCE_KIND, DEFAULT_DATASOURCE } from './constants';
import type {
  {{ .PluginPascalName }}Spec,
  DatasourceQueryResponse,
  QueryDatasourceClient,
} from './{{ .PluginName }}-types';

function buildTimeSeries(response?: DatasourceQueryResponse): TimeSeries[] {
  if (!response) {
    return [];
  }

  return response.data.map((res) => {
    const { name, values } = res;

    // TODO: map your data to the timeseries format expected for Panel plugins
    return {
      name,
      values,
    };
  });
}

export const getTimeSeriesData: TimeSeriesQueryPlugin<{{ .PluginPascalName }}Spec>['getTimeSeriesData'] = async (
  spec,
  context,
) => {
  // return empty data if the query is empty
  if (spec.query === undefined || spec.query === null || spec.query === '') {
    return { series: [] };
  }

  const query = replaceVariables(spec.query, context.variableState);

  // A default datasource will be selected by matching the kind of datasource if not provided
  const datasource =
    datasourceSelectValueToSelector(
      spec.datasource ?? DEFAULT_DATASOURCE,
      context.variableState,
      await context.datasourceStore.listDatasourceSelectItems(DATASOURCE_KIND),
    ) ?? DEFAULT_DATASOURCE;
  const client = await context.datasourceStore.getDatasourceClient<QueryDatasourceClient>(datasource);

  const { start, end } = context.timeRange;

  const response = await client.query({
    start: start.getTime().toString(),
    end: end.getTime().toString(),
    query,
  });

  const chartData: TimeSeriesData = {
    series: buildTimeSeries(response),
    timeRange: { start, end },
    stepMs: 30 * 1000,
    metadata: {
      executedQueryString: query,
    },
  };

  return chartData;
};
