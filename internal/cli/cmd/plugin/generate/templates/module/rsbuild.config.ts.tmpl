import type { ModuleFederationOptions } from '@module-federation/rsbuild-plugin';
import { pluginModuleFederation } from '@module-federation/rsbuild-plugin';
import { defineConfig } from '@rsbuild/core';
import type { PluginReactOptions, ReactCompilerOptions } from '@rsbuild/plugin-react';
import { pluginReact } from '@rsbuild/plugin-react';

import packageJson from './package.json' with { type: 'json' };

const name = '{{.ModulePascalName}}';
const version = process.env.NODE_ENV === 'development' ? undefined : packageJson.version;
export const assetPrefix = `/plugins/${name}/`;
const publicPath = version ? `/plugins/${name}~${version}/` : assetPrefix;
const globalName = version ? `${name}_${version}`.replace(/[^a-zA-Z0-9_$]/g, '_') : name;

// Plugins must run on React 18 and 19 hosts, so the compiled output targets React 18 and relies on the
// `react-compiler-runtime` package. Keep the target in sync with `.swcrc`.
const reactCompilerOptions: ReactCompilerOptions = { target: '18' };

// Always compile JSX to `react/jsx-runtime`, even in dev mode, so the plugin uses the host's shared JSX runtime. The
// default dev transform imports `react/jsx-dev-runtime`, which the host doesn't share: the plugin would bundle its own
// React 18 dev runtime, which crashes on a React 19 host. Fast Refresh is not affected.
const swcReactOptions: PluginReactOptions['swcReactOptions'] = { development: false };

// Expose the components that will be used in the UI, either Perses UI or embedded.
const exposedModules: ModuleFederationOptions['exposes'] = [
  {{- range $index, $item := .ExposedModules }}
      {{- template "exposedModule" $item -}}
  {{- end }}
];

export default defineConfig({
  server: {
    port: 3000 + Math.floor(Math.random() * 1000),
    strictPort: false,
    printUrls: process.env.PERSES_CLI
      ? ({ port, protocol }) => {
          // custom output for `percli plugin start` to detect port for dev server
          console.log(`[PERSES_PLUGIN] NAME="${name}" PORT="${port}" PROTOCOL="${protocol}"\n`);
          console.log(`Local: ${protocol}://localhost:${port}`);
          return [];
        }
      : true,
    cors: { origin: '*' },
  },
  dev: { assetPrefix },
  source: { entry: { main: './src/index-federation.ts' } },
  output: {
    assetPrefix,
    copy: [{ from: 'package.json' }, { from: 'README.md' }, { from: 'LICENSE', to: './LICENSE', toType: 'file' }],
    distPath: {
      root: 'dist',
      js: '__mf/js',
      css: '__mf/css',
      font: '__mf/font',
    },
  },
  plugins: [
    pluginReact({ reactCompiler: reactCompilerOptions, swcReactOptions }),
    pluginModuleFederation({
      name,
      // Each installed version needs its own federation container.
      ...(version ? { library: { type: 'global', name: globalName } } : {}),
      exposes: exposedModules,
      shared: {
        react: { requiredVersion: packageJson.peerDependencies.react, singleton: true },
        // Use the host's JSX runtime: a bundled React 18 runtime crashes on a React 19 host.
        'react/jsx-runtime': { requiredVersion: packageJson.peerDependencies.react, singleton: true },
        'react-dom': { requiredVersion: packageJson.peerDependencies['react-dom'], singleton: true },
        echarts: { singleton: true },
        'date-fns': { singleton: true },
        'date-fns-tz': { singleton: true },
        lodash: { singleton: true },
        '@perses-dev/client': { singleton: true },
        '@perses-dev/components': { singleton: true },
        '@perses-dev/plugin-system': { singleton: true },
        '@perses-dev/explore': { singleton: true },
        '@perses-dev/dashboards': { singleton: true },
        '@emotion/react': { requiredVersion: '^11.11.3', singleton: true },
        '@emotion/styled': { singleton: true },
        '@hookform/resolvers': { singleton: true },
        '@tanstack/react-query': { singleton: true },
        'react-hook-form': { singleton: true },
        'react-router-dom': { singleton: true },
      },
      dts: false,
      runtime: false,
      getPublicPath: `function() { return (window.PERSES_PLUGIN_ASSETS_PATH || window.PERSES_APP_CONFIG?.api_prefix || "") + "${publicPath}"; }`,
    }),
  ],
  tools: {
    htmlPlugin: false,
    rspack: (config) => {
      config.output = config.output || {};
      if (process.env.NODE_ENV !== 'development') {
        config.output.publicPath = 'auto';
      }
      // Keep chunks from different installed versions out of each other's runtime.
      if (version) {
        config.output.uniqueName = globalName;
        config.output.chunkLoadingGlobal = `chunk_${globalName}`;
      }
      return config;
    },
  },
});
