{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {},
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist",
    "**/lib",
    "**/*.md",
    "**/*.mdx",
    "**/mock-query-range.json",
    "pnpm-lock.yaml",
    ".github/perses-ci",
    ".github/perses-ci/**"
  ]
}
