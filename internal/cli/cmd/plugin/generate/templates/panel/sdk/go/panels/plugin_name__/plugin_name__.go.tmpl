// Package {{ .PluginGoPackage }} provides the Dashboard-as-Code builder for the {{ .PluginPascalName }} panel plugin.
package {{ .PluginGoPackage }}

import (
	"github.com/perses/perses/go-sdk/common"
	"github.com/perses/perses/go-sdk/panel"
)

const PluginKind = "{{ .PluginPascalName }}"

type Legend struct {
	Position string               `json:"position" yaml:"position"`
	Mode     string               `json:"mode,omitempty" yaml:"mode,omitempty"`
	Size     string               `json:"size,omitempty" yaml:"size,omitempty"`
	Values   []common.Calculation `json:"values,omitempty" yaml:"values,omitempty"`
}

type QuerySettings struct {
	QueryIndex int    `json:"queryIndex" yaml:"queryIndex"`
	ColorMode  string `json:"colorMode" yaml:"colorMode"`
	ColorValue string `json:"colorValue" yaml:"colorValue"`
}

// PluginSpec follows the spec in schemas/panels/{{ .PluginName }}/{{ .PluginName }}.cue.
type PluginSpec struct {
	Legend        *Legend            `json:"legend,omitempty" yaml:"legend,omitempty"`
	Thresholds    *common.Thresholds `json:"thresholds,omitempty" yaml:"thresholds,omitempty"`
	QuerySettings []QuerySettings    `json:"querySettings,omitempty" yaml:"querySettings,omitempty"`
}

type Option func(plugin *Builder) error

type Builder struct {
	PluginSpec `json:",inline" yaml:",inline"`
}

func create(options ...Option) (Builder, error) {
	builder := &Builder{
		PluginSpec: PluginSpec{},
	}

	for _, opt := range options {
		if err := opt(builder); err != nil {
			return *builder, err
		}
	}

	return *builder, nil
}

// {{ .PluginPascalName }} sets the {{ .PluginPascalName }} plugin on a panel.
func {{ .PluginPascalName }}(options ...Option) panel.Option {
	return func(builder *panel.Builder) error {
		plugin, err := create(options...)
		if err != nil {
			return err
		}
		builder.Spec.Plugin.Kind = PluginKind
		builder.Spec.Plugin.Spec = plugin.PluginSpec
		return nil
	}
}

func WithLegend(legend Legend) Option {
	return func(builder *Builder) error {
		builder.Legend = &legend
		return nil
	}
}

func WithThresholds(thresholds common.Thresholds) Option {
	return func(builder *Builder) error {
		builder.Thresholds = &thresholds
		return nil
	}
}

func WithQuerySettings(querySettings ...QuerySettings) Option {
	return func(builder *Builder) error {
		builder.QuerySettings = append(builder.QuerySettings, querySettings...)
		return nil
	}
}
