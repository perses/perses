import { Box, Stack } from '@mui/material';
import { ErrorAlert, ErrorBoundary, LoadingOverlay, NoDataOverlay } from '@perses-dev/components';
import { useExplorerManagerContext } from '@perses-dev/explore';
import { DataQueriesProvider, MultiQueryEditor, useDataQueries } from '@perses-dev/plugin-system';
import type { QueryDefinition, QueryPluginType } from '@perses-dev/spec';
import type { ReactElement } from 'react';
import { useCallback, useMemo, useState } from 'react';

interface {{ .PluginPascalName }}QueryParams {
  queries?: QueryDefinition[];
}

// TODO: change to the query type your explore view supports. It must be a QueryPluginType from @perses-dev/spec
// (TimeSeriesQuery, TraceQuery, ProfileQuery, LogQuery, ...), and the result handling below must match its data shape.
const QUERY_TYPE = 'TraceQuery';
const QUERY_TYPES: QueryPluginType[] = [QUERY_TYPE];
const EMPTY_QUERIES: QueryDefinition[] = [];
const CONTAINER_SX = { width: '100%' };

function SearchResultsPanel(): ReactElement | null {
  const { isFetching, isLoading, queryResults } = useDataQueries(QUERY_TYPE);

  // no query executed, show empty panel
  if (queryResults.length === 0) {
    return null;
  }

  if (isLoading || isFetching) {
    return <LoadingOverlay />;
  }

  const queryError = queryResults.find((d) => d.error);
  if (queryError) {
    throw queryError.error;
  }

  // `searchResult` is specific to TraceData; adapt this check to your query type's data.
  const dataFound = queryResults.some((result) => (result.data?.searchResult ?? []).length > 0);
  if (!dataFound) {
    return <NoDataOverlay resource="{{ .PluginPascalName }}" />;
  }

  // TODO: add panels or other components to explore the data

  return <div>Explore goes here!</div>;
}

export function {{ .PluginPascalName }}(): ReactElement {
  const {
    data: { queries = EMPTY_QUERIES },
    setData,
  } = useExplorerManagerContext<{{ .PluginPascalName }}QueryParams>();

  const [queryDefinitions, setQueryDefinitions] = useState(queries);
  const handleQueryRun = useCallback((): void => {
    setData({ queries: queryDefinitions });
  }, [queryDefinitions, setData]);
  const resetKeys = useMemo(() => [queries], [queries]);

  return (
    <Stack gap={2} sx={CONTAINER_SX}>
      <MultiQueryEditor
        queryTypes={QUERY_TYPES}
        onChange={setQueryDefinitions}
        onQueryRun={handleQueryRun}
        queries={queryDefinitions}
      />

      <ErrorBoundary FallbackComponent={ErrorAlert} resetKeys={resetKeys}>
        <DataQueriesProvider definitions={queries}>
          <Box height={700}>
            <SearchResultsPanel />
          </Box>
        </DataQueriesProvider>
      </ErrorBoundary>
    </Stack>
  );
}
